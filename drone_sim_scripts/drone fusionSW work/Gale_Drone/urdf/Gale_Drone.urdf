      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://Gale_Drone/meshes/Rotor1.STL" /></geometry>
    </collision>
  </link>
  <joint name="Joint_Rotor1" type="continuous">
    <origin xyz="1.2 0.0 0.3995" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Rotor1" />
    <axis xyz="0 0 1" />
