<!-- NasaDrone copy: base_link visual = full body mesh from DroneDesignBody+Sensors.step + hubs/solar (base_link_full.STL); rotor joints raised to the CAD blade planes (upper 0.3995 m, lower 0.302 m). Original note: Gale Crater methane drone, Design D. Exported from SolidWorks (sw_urdf_exporter), corrected:
     masses set to the Design D budget (28.34 kg total: base 24.93 + 6 x 0.568 rotors), inertias recomputed,
     Rotor1/Rotor6 joint origins restored, rotor axes set to +Z, rotor meshes regenerated, effort/velocity limits added.
     base_link mesh is the original partial export: re-export for full visuals. -->
<robot name="Gale_Drone">
  <link name="base_link">
    <inertial>
      <origin xyz="0.000000 0.000000 0.018293" rpy="0 0 0" />
      <mass value="24.9280" />
      <inertia ixx="5.794874" ixy="0.000000" ixz="-0.000000" iyy="5.794874" iyz="-0.000000" izz="10.789381" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://Gale_Drone/meshes/base_link_full.STL" /></geometry>
      <material name=""><color rgba="0.098 0.149 0.4 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://Gale_Drone/meshes/base_link_full.STL" /></geometry>
    </collision>
  </link>
