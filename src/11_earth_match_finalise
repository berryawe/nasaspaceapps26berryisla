import numpy as np
import pandas as pd
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent.parent

# Defining constants
CLEAN_DIR = BASE_DIR / 'data' / 'clean'
A_FILE = CLEAN_DIR / 'earth_matches_method_a_final.csv'     # Method A: climate first, then terrain
B_FILE = CLEAN_DIR / 'earth_matches_method_b_final.csv'     # Method B: terrain first, then climate
OUT_FILE = CLEAN_DIR / 'earth_matches_combined.csv'         # every candidate from both methods, scored on the same rules
TOP_FILE = CLEAN_DIR / 'earth_top3_vs_mars.csv'             # the top matches against Gale, indicator by indicator
TOP_N = 3                                                   # how many best matches to report

# Our priorities, applied the same way to both methods
CLIMATE_WEIGHT = 0.6             # 1. weather first: this is a weather-based analogue for drone testing (terrain gets the other 40%)
MAX_NIGHT_MIN_C = -35.0          # 2. a site must pass the Method A gates: nights cold enough...
MIN_RANGE_K = 8.0                #    ...and a real day-night cycle (polar night has none)
                                 # 3. only terrain that passed the elevation check can win (ASTER is unreliable over ice)
                                 # 4. air density is a gap and a tie-breaker, not part of the score (Earth is always far denser)
SAME_REGION_KM = 200.0           # best windows closer than this count as the same region when comparing methods
NEAR_TIE = 0.01                  # combined scores closer than this are reported as a tie
SWEEP = np.round(np.arange(0.0, 1.01, 0.1), 1)   # climate weights tried, to see whether the top 3 depend on our choice

# Names for the Method A sites (Method B sites already have region names); display only
A_NAMES = {'30.0°N 85.0°E': 'Tibetan plateau', '55.0°N 65.0°W': 'Labrador-Quebec',
           '70.0°N 80.0°E': 'Northern Siberia', '75.0°S 20.0°E': 'Queen Maud Land, Antarctica',
           '70.0°S 50.0°E': 'East Antarctica (Enderby Land)', '70.0°S 130.0°E': 'East Antarctica (Wilkes Land)',
           '70.0°S 105.0°E': 'East Antarctica (Wilkes Land)', '75.0°N 40.0°W': 'Greenland ice sheet'}

# Indicator names in the tidy tables -> short column names
RENAME = {'Climate match': 'CLIMATE_SCORE', 'Terrain match': 'TERRAIN_SCORE', 'Best month': 'BEST_MONTH',
          'Night minimum air temperature': 'T2M_MIN_C', 'Day-night temperature range': 'T2M_RANGE_K',
          'Mean wind speed, 2 m': 'WS2M_MS', 'Wind night/day ratio': 'WIND_NIGHT_DAY_RATIO',
          'Air density compared with Mars': 'DENSITY_VS_MARS', 'Dust optical depth': 'DUST_TAU',
          'Window centre latitude': 'WIN_LAT', 'Window centre longitude': 'WIN_LON', 'Elevation range': 'ELEV_RANGE',
          'Mean slope': 'SLOPE_MEAN', 'Roughness, 1 km window': 'ROUGHNESS_1000M', 'Roughness, 5 km window': 'ROUGHNESS_5000M',
          'Lowest point, 1 km grid': 'ELEV_MIN_1KM', 'Highest point, 1 km grid': 'ELEV_MAX_1KM',
          'Terrain data reliability': 'TERRAIN_DATA'}
NUMBER_COLS = [c for c in RENAME.values() if c not in ('BEST_MONTH', 'TERRAIN_DATA')]
# Short headings and decimals for the printed tables
HEAD = {'RANK': 'Rank', 'METHOD': 'Method', 'PLACE': 'Place', 'COMBINED_SCORE': 'Combined', 'CLIMATE_SCORE': 'Climate',
        'TERRAIN_SCORE': 'Terrain', 'T2M_MIN_C': 'Night min (C)', 'T2M_RANGE_K': 'Range (K)', 'WS2M_MS': 'Wind (m/s)',
        'DENSITY_VS_MARS': 'Density (x Mars)', 'WHY': 'Reason'}
DECIMALS = {'COMBINED_SCORE': 2, 'CLIMATE_SCORE': 2, 'TERRAIN_SCORE': 2, 'T2M_MIN_C': 1, 'T2M_RANGE_K': 1, 'WS2M_MS': 1,
            'DENSITY_VS_MARS': 0}


def heading(text):
    print(f'\n{text}\n{"-" * len(text)}')


def table(df, cols):
    """Print a table with short headings and sensible decimals."""
    out = df[cols].copy()
    for c in cols:
        if c in DECIMALS:
            out[c] = out[c].map(lambda v: f'{v:.{DECIMALS[c]}f}' if pd.notna(v) else '')
    out = out.rename(columns=HEAD).fillna('')
    print(out.to_string(index=False))


def load(path, method):
    """Read a tidy table (indicators as rows, one column per site) and turn it into one row per site."""
    raw = pd.read_csv(path)
    sites = raw.set_index('Indicator')[list(raw.columns[5:])].T.rename(columns=RENAME)
    sites = sites.reset_index().rename(columns={'index': 'SITE'})
    sites['SITE'] = sites['SITE'].str.replace(r'^#\d+ ', '', regex=True)
    sites.insert(0, 'METHOD', method)
    return sites, raw


a_df, a_raw = load(A_FILE, 'A')
b_df, _ = load(B_FILE, 'B')
all_df = pd.concat([a_df, b_df], ignore_index=True)
for c in NUMBER_COLS:
    all_df[c] = pd.to_numeric(all_df[c], errors='coerce')
all_df['PLACE'] = [A_NAMES.get(s, s) if m == 'A' else s for m, s in zip(all_df['METHOD'], all_df['SITE'])]
all_df['PLACE_FULL'] = [f'{A_NAMES[s]} ({s})' if m == 'A' and s in A_NAMES else s for m, s in zip(all_df['METHOD'], all_df['SITE'])]
all_df = all_df[['METHOD', 'SITE', 'PLACE', 'PLACE_FULL', 'BEST_MONTH'] + NUMBER_COLS + ['TERRAIN_DATA']]

# ---------------------------------------------------------------- Same rules for every candidate
all_df['GATES_OK'] = (all_df['T2M_MIN_C'] <= MAX_NIGHT_MIN_C) & (all_df['T2M_RANGE_K'] >= MIN_RANGE_K)
all_df['TERRAIN_OK'] = ~all_df['TERRAIN_DATA'].str.startswith('Unverified')
all_df['STATUS'] = np.where(~all_df['GATES_OK'], 'Fails climate gates',
                            np.where(~all_df['TERRAIN_OK'], 'Provisional (terrain unverified)', 'Eligible'))
reasons = []
for r in all_df.itertuples():
    why = []
    if r.T2M_MIN_C > MAX_NIGHT_MIN_C:
        why.append(f'nights only {r.T2M_MIN_C:.0f} C')
    if r.T2M_RANGE_K < MIN_RANGE_K:
        why.append(f'day-night range {r.T2M_RANGE_K:.1f} K')
    if not r.TERRAIN_OK:
        why.append('terrain unverified')
    reasons.append(', '.join(why))
all_df['WHY'] = reasons


def combined(df, w):
    return w * df['CLIMATE_SCORE'] + (1 - w) * df['TERRAIN_SCORE']


all_df['COMBINED_SCORE'] = combined(all_df, CLIMATE_WEIGHT)
# Rank: eligible sites first, by combined score; ties go to the thinner air (lower density compared with Mars)
all_df = all_df.sort_values(['STATUS', 'COMBINED_SCORE', 'DENSITY_VS_MARS'], ascending=[True, False, True]).reset_index(drop=True)
eligible = all_df['STATUS'] == 'Eligible'
all_df['RANK'] = np.nan
all_df.loc[eligible, 'RANK'] = np.arange(1, eligible.sum() + 1)
all_df['RANK'] = all_df['RANK'].astype('Int64')
top = all_df[eligible].head(TOP_N).reset_index(drop=True)

# ---------------------------------------------------------------- Results
print('EARTH LOCATIONS THAT BEST MATCH GALE CRATER (Mount Sharp)')
print('=' * 58)
print(f'Weather {CLIMATE_WEIGHT:.0%} + terrain {1 - CLIMATE_WEIGHT:.0%}  |  nights <= {MAX_NIGHT_MIN_C:.0f} C, day-night range >= {MIN_RANGE_K:.0f} K  |  '
      f'verified terrain only')

heading(f'TOP {TOP_N} MATCHES')
table(top, ['RANK', 'METHOD', 'PLACE', 'COMBINED_SCORE', 'CLIMATE_SCORE', 'TERRAIN_SCORE', 'T2M_MIN_C', 'T2M_RANGE_K', 'WS2M_MS',
            'DENSITY_VS_MARS'])
for i in range(len(top) - 1):
    if top.loc[i, 'COMBINED_SCORE'] - top.loc[i + 1, 'COMBINED_SCORE'] < NEAR_TIE:
        print(f'Note: ranks {i + 1} and {i + 2} are within {NEAR_TIE} of each other, effectively a tie.')

heading('OTHER ELIGIBLE SITES')
rest = all_df[eligible].iloc[TOP_N:]
table(rest, ['RANK', 'METHOD', 'PLACE', 'COMBINED_SCORE', 'CLIMATE_SCORE', 'TERRAIN_SCORE']) if len(rest) else print('none')

heading('NOT RANKED: PASS THE CLIMATE GATES BUT TERRAIN IS UNVERIFIED (could not win yet)')
table(all_df[all_df['STATUS'] == 'Provisional (terrain unverified)'], ['METHOD', 'PLACE', 'COMBINED_SCORE', 'CLIMATE_SCORE', 'TERRAIN_SCORE', 'WHY'])

heading('NOT RANKED: FAIL THE CLIMATE GATES')
table(all_df[all_df['STATUS'] == 'Fails climate gates'], ['METHOD', 'PLACE', 'COMBINED_SCORE', 'CLIMATE_SCORE', 'TERRAIN_SCORE', 'WHY'])

# Do the two methods find the same places?
heading(f'DO THE METHODS AGREE? (best windows within {SAME_REGION_KM:.0f} km)')
found = False
for a in all_df[all_df['METHOD'] == 'A'].itertuples():
    for b in all_df[all_df['METHOD'] == 'B'].itertuples():
        la1, lo1, la2, lo2 = np.radians([a.WIN_LAT, a.WIN_LON, b.WIN_LAT, b.WIN_LON])
        km = 2 * 6371 * np.arcsin(np.sqrt(np.sin((la2 - la1) / 2) ** 2 + np.cos(la1) * np.cos(la2) * np.sin((lo2 - lo1) / 2) ** 2))
        if km <= SAME_REGION_KM:
            found = True
            print(f'Yes: A {a.PLACE} and B {b.PLACE} are {km:.0f} km apart')
if not found:
    print('No overlap')

heading('METHOD A AGAINST METHOD B (best eligible site from each)')
table(pd.concat([all_df[eligible & (all_df['METHOD'] == m)].head(1) for m in ('A', 'B')]),
      ['RANK', 'METHOD', 'PLACE', 'COMBINED_SCORE', 'CLIMATE_SCORE', 'TERRAIN_SCORE'])

# Do the top 3 depend on how much we weight weather?
heading('DOES THE TOP 3 DEPEND ON THE WEATHER WEIGHT?')
el = all_df[eligible]
firsts = []
for w in SWEEP:
    s = el.assign(S=combined(el, w)).sort_values(['S', 'DENSITY_VS_MARS'], ascending=[False, True]).head(TOP_N)
    firsts.append(s['PLACE'].iloc[0])
    print(f'Weather {w:>4.0%} / terrain {1 - w:>4.0%}:  ' + '  >  '.join(s['PLACE']))
stable = [w for w, p in zip(SWEEP, firsts) if p == top['PLACE'].iloc[0]]
print(f'\n{top["PLACE"].iloc[0]} stays first for weather weights {min(stable):.0%} to {max(stable):.0%}.')

# ---------------------------------------------------------------- The top matches against Gale, side by side (saved)
mars_ref = a_raw.set_index('Indicator')['Mount Sharp / Gale (Mars)']
spec = [('Match', 'Method', '', 'METHOD', None), ('Match', 'Combined score', '0-1', 'COMBINED_SCORE', 2),
        ('Match', 'Climate match', '0-1', 'CLIMATE_SCORE', 2), ('Match', 'Terrain match', '0-1', 'TERRAIN_SCORE', 2),
        ('Climate', 'Best month', '', 'BEST_MONTH', None),
        ('Climate', 'Night minimum air temperature', 'deg C', 'T2M_MIN_C', 1), ('Climate', 'Day-night temperature range', 'K', 'T2M_RANGE_K', 1),
        ('Climate', 'Mean wind speed, 2 m', 'm/s', 'WS2M_MS', 1), ('Climate', 'Wind night/day ratio', '', 'WIND_NIGHT_DAY_RATIO', 2),
        ('Climate', 'Dust optical depth', '', 'DUST_TAU', 3), ('Climate', 'Air density compared with Mars', 'x Mars', 'DENSITY_VS_MARS', 0),
        ('Terrain', 'Elevation range', 'm', 'ELEV_RANGE', 0), ('Terrain', 'Mean slope', 'deg', 'SLOPE_MEAN', 1),
        ('Terrain', 'Roughness, 1 km window', 'm', 'ROUGHNESS_1000M', 1), ('Terrain', 'Roughness, 5 km window', 'm', 'ROUGHNESS_5000M', 1),
        ('Location', 'Best window latitude', 'deg', 'WIN_LAT', 2), ('Location', 'Best window longitude', 'deg', 'WIN_LON', 2),
        ('Check', 'Terrain data reliability', '', 'TERRAIN_DATA', None)]
rows = []
for group, indicator, unit_text, col, dec in spec:
    mars_value = mars_ref.get(indicator, '')
    if pd.isna(mars_value):
        mars_value = ''
    values = [('' if pd.isna(v) else v) if dec is None else ('' if pd.isna(v) else (int(round(v)) if dec == 0 else round(float(v), dec)))
              for v in top[col]]
    rows.append([group, indicator, unit_text, mars_value] + values)
top_names = [f'#{i + 1} {p}' for i, p in enumerate(top['PLACE_FULL'])]
top_df = pd.DataFrame(rows, columns=['Group', 'Indicator', 'Unit', 'Gale / Mount Sharp (Mars)'] + top_names)
heading(f'TOP {TOP_N} AGAINST GALE')
print(top_df.drop(columns='Group').to_string(index=False))

# Save
all_df[['RANK', 'STATUS', 'WHY', 'METHOD', 'PLACE_FULL', 'COMBINED_SCORE', 'CLIMATE_SCORE', 'TERRAIN_SCORE', 'BEST_MONTH'] + NUMBER_COLS[2:] +
       ['TERRAIN_DATA']].rename(columns={'PLACE_FULL': 'PLACE'}).round(3).to_csv(OUT_FILE, index=False)
top_df.to_csv(TOP_FILE, index=False)
print(f'\nSaved {OUT_FILE.name} (all {len(all_df)} candidates) and {TOP_FILE.name} (top {TOP_N} against Gale) in data/clean')